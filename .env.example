# Copia este archivo como .env y define una contraseña local fuerte para desarrollo.
MSSQL_SA_PASSWORD=ChangeMe_UseA_Strong_Local_Password_123!

# API Node.js (arranca desde Api/; la API lee este archivo de la raíz)
API_HOST=127.0.0.1
API_PORT=3000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SQL_SERVER=127.0.0.1
SQL_PORT=1433
SQL_DATABASE=WideWorldImporters
SQL_USER=sa
# En desarrollo local, la API reutiliza MSSQL_SA_PASSWORD si SQL_PASSWORD se omite.
# SQL_PASSWORD=
SQL_ENCRYPT=true
SQL_TRUST_SERVER_CERTIFICATE=true
SQL_CONNECTION_TIMEOUT_MS=15000
SQL_REQUEST_TIMEOUT_MS=30000
SQL_POOL_MAX=10
SQL_POOL_MIN=0
SQL_POOL_IDLE_TIMEOUT_MS=30000
